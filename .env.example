# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never put a real value in this file.

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous key. Public by design: it grants no privileges on its
# own, and row-level security decides what it can read.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
